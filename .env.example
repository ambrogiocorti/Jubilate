# Copy to .env.local (never commit real values).
# Only PUBLISHABLE values belong here: they are embedded in the browser bundle.
# Never put the service_role key or any secret in a VITE_ variable.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public URL of the deployed app (used for auth redirects), e.g. https://jubilate.pages.dev
VITE_SITE_URL=http://localhost:5173
